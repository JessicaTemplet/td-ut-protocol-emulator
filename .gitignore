_build/
# bin/main.ml writes the two fallback tops (tt_um_template, tt_um_system) here.
/build/
*.install
.merlin
.commit_msg.txt

# LibreLane/tt_tool.py scaffold: tt/ is a clone of TinyTapeout/tt-support-tools
# (branch ihp-sg13cmos5l; see README), runs/ is LibreLane's own multi-GB run
# output, and src/config_merged.json / src/user_config.json are generated by
# `tt_tool.py --create-user-config`. src/tt_um_dual.v IS tracked: it is the
# generated top that CI builds (scripts/run_main.sh regenerates it from the
# Hardcaml sources).
/tt/
/runs/
/src/config_merged.json
/src/user_config.json

# Output of scripts/blackbox_macro_gds.py: a copy of the signoff GDS with the SRAM
# macro's internals stripped, used only to check our own logic's DRC
# independent of the macro (never the submission GDS). Regenerable.
/drc_verify/

.venv-cocotb/
gl_test/sim_build/
gl_test/results.xml
gl_test/*.fst
gl_test/gate_level_netlist.v
__pycache__/

formal/shadow_fifo.v
formal/fifo_prove/
formal/fifo_cover/
formal/fifo/

# scripts/run_regression.sh keeps each step's full output here (cleared every run).
/regress_logs/

# Built tdasm binary (tools/tdasm/test.sh rebuilds it).
/tools/tdasm/tdasm

# Local hardening output (CI produces its own as an artifact), and stray
# waveforms, as in the Tiny Tapeout template.
/tt_submission/
*.vcd
*.fst

# Private working notes never go in this repo: session handoffs, AI-assistant
# config, and authorship timestamps (kept outside the repo).
*HANDOFF*
*handoff*.md
SESSION_*.md
.claude/
CLAUDE.md
*.ots
*.bundle
