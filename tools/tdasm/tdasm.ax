; tdasm - assembler and program loader for the TD-uT dual-engine
; protocol emulator (tt_um_dual).
;
; Reads one `.tds` source holding both engines' programs, checks it,
; and writes what the chip needs:
;
;   tdasm prog.tds                      listing on stdout
;   tdasm prog.tds --json out.json      gl_test-style vectors JSON
;   tdasm prog.tds --load out.load      byte-serial pin script for a host
;
; The instruction encodings are the ones engine.ml and
; protocol_engine.ml define - [15:14] opcode | [13:11] pin | [10] mode |
; [9:0] payload - and the load order and checksum are dual_loader.ml's:
; prescale byte, optional bit-pipe config bytes (cfg_sel), uE0 words,
; uE1 words, each word low byte then high byte, then `go`. The checksum
; is the running XOR of every committed byte, config bytes included,
; which is what the chip shows on uo_out before `go`.
;
; See README.md beside this file for the source syntax.
(import IO)
(import Str)
(import Fmt)
(import Sys)
(import Vec)
(import Err)

; ------------------------------------------------------------------
; Limits from the RTL
; ------------------------------------------------------------------
; Loader.addr_width = 9, so each engine holds 512 words.
(:: ramDepth Int)
(fn (ramDepth)
  512)

; Bitpipe.cfg_bytes.
(:: cfgMax Int)
(fn (cfgMax)
  9)

; Section numbers. 0 is "before any .phys/.protocol line".
(:: sectNone Int)
(fn (sectNone)
  0)

(:: sectPhys Int)
(fn (sectPhys)
  1)

(:: sectProto Int)
(fn (sectProto)
  2)

; ------------------------------------------------------------------
; Assembler state
; ------------------------------------------------------------------
; Labels are three parallel vectors (name, section, address) rather than
; a vector of records, so every element is either a plain Int or a
; String the vector owns a share of.
(struct Asm
  (mut errors : Int)
  (mut sect : Int)
  (mut prescale : Int)
  (mut prescaleSet : Bool)
  (cfg : (Vec Int))
  (phys : (Vec Int))
  (proto : (Vec Int))
  (physSrc : (Vec String))
  (protoSrc : (Vec String))
  (labNames : (Vec String))
  (labSect : (Vec Int))
  (labAddr : (Vec Int)))

(:: newAsm Asm)
(fn (newAsm)
  (Asm
    0
    0
    0
    false
    vecNew
    vecNew
    vecNew
    vecNew
    vecNew
    vecNew
    vecNew
    vecNew))

;@axiom:effect(io)
(:: report (-> Asm Int String Int))
(fn (report a lineNo msg)
  {
    (eprintln "tdasm: line {lineNo}: {msg}")
    (set a.errors (+ a.errors 1))
    0
  })

; ------------------------------------------------------------------
; Lexing
; ------------------------------------------------------------------
(:: neg (-> Bool Bool))
(fn (neg b)
  (if b
    false
    true))

(:: isSep (-> Int Bool))
(fn (isSep b)
  (|| (== b 32) (|| (== b 9) (|| (== b 13) (== b 44)))))

; The line without its `;` or `#` comment.
(:: stripComment (-> String String))
(fn (stripComment s)
  (let (
    (mut i 0)
    (mut cut (strLen s))
  )
    {
      (while (< i cut)
        (let ((b (strByte s i)))
          (if (|| (== b 59) (== b 35))
            (set cut i)
            (set i (+ i 1)))))
      (strSlice s 0 cut)
    }))

; Whitespace/comma-separated tokens of one line, comment removed.
(:: tokens (-> String (Vec String)))
(fn (tokens line)
  (let (
    (s (stripComment line))
    (out vecNew)
    (mut i 0)
    (mut start (- 0 1))
  )
    {
      (while (< i (strLen s))
        {
          (if (isSep (strByte s i))
            (if (>= start 0)
              {
                (vecPush out (strSlice s start (- i start)))
                (set start (- 0 1))
              }
              0)
            (if (< start 0)
              (set start i)
              0))
          (set i (+ i 1))
        })
      (if (>= start 0)
        (vecPush out (strSlice s start (- (strLen s) start)))
        out)
      out
    }))

(:: tok (-> (Vec String) Int String))
(fn (tok v i)
  (vecGet v i))

; A decimal or 0x/0X hex literal, or None.
(:: parseNum (-> String (Option Int)))
(fn (parseNum s)
  (if (&& (> (strLen s) 2) (&& (== (strByte s 0) 48) (|| (== (strByte s 1) 120) (== (strByte s 1) 88))))
    (let (
      (mut i 2)
      (mut acc 0)
      (mut ok true)
    )
      {
        (while (< i (strLen s))
          {
            (match (strHexVal (strByte s i))
              ((Some d)
                {
                  (set acc (+ (* acc 16) d))
                  0
                }
              )
              ((None)
                {
                  (set ok false)
                  0
                }
              ))
            (set i (+ i 1))
          })
        (if ok
          (Some acc)
          (None))
      })
    (strParseInt s)))

(:: endsWithColon (-> String Bool))
(fn (endsWithColon s)
  (&& (> (strLen s) 1) (== (strByte s (- (strLen s) 1)) 58)))

(:: labelOf (-> String String))
(fn (labelOf s)
  (strSlice s 0 (- (strLen s) 1)))

(:: isIdentByte (-> Int Bool))
(fn (isIdentByte b)
  (|| (strIsAlpha b) (|| (strIsDigit b) (== b 95))))

(:: validLabel (-> String Bool))
(fn (validLabel s)
  (let (
    (mut i 0)
    (mut ok (&& (> (strLen s) 0) (neg (strIsDigit (strByte s 0)))))
  )
    {
      (while (&& ok (< i (strLen s)))
        {
          (set ok (isIdentByte (strByte s i)))
          (set i (+ i 1))
        })
      ok
    }))

; ------------------------------------------------------------------
; Labels
; ------------------------------------------------------------------
; Index of `name` in the label table, or None.
(:: findLabel (-> Asm String (Option Int)))
(fn (findLabel a name)
  (let (
    (mut i 0)
    (mut found (- 0 1))
  )
    {
      (while (&& (< found 0) (< i (vecLen a.labNames)))
        {
          (if (strEq (vecGet a.labNames i) name)
            (set found i)
            0)
          (set i (+ i 1))
        })
      (if (>= found 0)
        (Some found)
        (None))
    }))

;@axiom:effect(io)
(:: defineLabel (-> Asm Int String Int Int))
(fn (defineLabel a lineNo name addr)
  (if (== a.sect (sectNone))
    (report a lineNo (format "label `{name}` outside a .phys or .protocol section"))
    (neg (validLabel name))
    (report a lineNo (format "`{name}` is not a valid label name"))
    (match (findLabel a name)
      ((Some i) (report a lineNo (format "label `{name}` defined twice")))
      ((None)
        {
          (vecPush a.labNames name)
          (vecPush a.labSect a.sect)
          (vecPush a.labAddr addr)
          0
        }
      ))))

; ------------------------------------------------------------------
; Operands
; ------------------------------------------------------------------
; Operand `i` of an instruction line, checked against [0, hi]. Reports
; and answers 0 when it is missing or out of range.
;@axiom:effect(io)
(:: operand (-> Asm Int (Vec String) Int String Int Int))
(fn (operand a lineNo ts i what hi)
  (if (>= i (vecLen ts))
    {
      (report a lineNo (format "missing {what} operand"))
      0
    }
    (let ((t (tok ts i)))
      (match (parseNum t)
        ((None)
          {
            (report a lineNo (format "{what} `{t}` is not a number"))
            0
          }
        )
        ((Some n)
          (if (|| (< n 0) (> n hi))
            {
              (report a lineNo (format "{what} {n} is out of range 0..{hi}"))
              0
            }
            n)
        )))))

; A branch target: a number, or a label in the current section.
;@axiom:effect(io)
(:: target (-> Asm Int (Vec String) Int Int))
(fn (target a lineNo ts i)
  (if (>= i (vecLen ts))
    {
      (report a lineNo "missing branch target")
      0
    }
    (let ((t (tok ts i)))
      (match (parseNum t)
        ((Some n)
          (if (|| (< n 0) (>= n (ramDepth)))
            {
              (report a lineNo (format "branch target {n} is out of range 0..511"))
              0
            }
            n)
        )
        ((None)
          (match (findLabel a t)
            ((None)
              {
                (report a lineNo (format "undefined label `{t}`"))
                0
              }
            )
            ((Some k)
              (if (!=
                (cast Int (vecGet a.labSect k))
                a.sect)
                {
                  (report a lineNo (format "label `{t}` belongs to the other engine"))
                  0
                }
                (cast Int (vecGet a.labAddr k)))
            ))
        )))))

;@axiom:effect(io)
(:: arity (-> Asm Int (Vec String) Int Int))
(fn (arity a lineNo ts n)
  (if (> (vecLen ts) (+ n 1))
    (let ((m (tok ts 0)))
      (report a lineNo (format "too many operands for `{m}` (takes {n})")))
    0))

; ------------------------------------------------------------------
; Encoding (engine.ml / protocol_engine.ml)
; ------------------------------------------------------------------
(:: enc (-> Int Int Int Int Int))
(fn (enc opcode pin mode payload)
  (| (<< (& opcode 3) 14) (| (<< (& pin 7) 11) (| (<< (& mode 1) 10) (& payload 1023)))))

; The ops bit a `pipe_ctrl` flag word sets, or 0 for an unknown word.
(:: pipeFlag (-> String Int))
(fn (pipeFlag t)
  (if (strEq t "reset")
    1
    (strEq t "idle_high")
    2
    (strEq t "crc_init")
    4
    0))

; Optional flag words after `pipe_ctrl`.
;@axiom:effect(io)
(:: pipeCtrlOps (-> Asm Int (Vec String) Int))
(fn (pipeCtrlOps a lineNo ts)
  (let (
    (mut i 1)
    (mut ops 0)
  )
    {
      (while (< i (vecLen ts))
        (let ((t (tok ts i)))
          {
            (set ops (| ops (pipeFlag t)))
            (if (== (pipeFlag t) 0)
              (report a lineNo (format "pipe_ctrl flag `{t}` is not reset, idle_high or crc_init"))
              0)
            (set i (+ i 1))
          }))
      ops
    }))

; uE0 (phys) instruction word, or -1 when the mnemonic is unknown.
;@axiom:effect(io)
(:: encPhys (-> Asm Int (Vec String) Int))
(fn (encPhys a ln ts)
  (let ((m (tok ts 0)))
    (if (|| (strEq m "wait_fall") (strEq m "wait_rise"))
      (let (
        (pin (operand
          a
          ln
          ts
          1
          "pin"
          7))
        (ticks (if (> (vecLen ts) 2)
          (operand
            a
            ln
            ts
            2
            "timeout"
            1023)
          0))
      )
        {
          (arity a ln ts 2)
          (enc
            0
            pin
            (if (strEq m "wait_rise")
              1
              0)
            ticks)
        })
      (strEq m "halt")
      {
        (arity a ln ts 0)
        (enc 0 7 0 0)
      }
      (strEq m "emit")
      (let (
        (pin (operand
          a
          ln
          ts
          1
          "pin"
          7))
        (lvl (operand
          a
          ln
          ts
          2
          "level"
          1))
      )
        {
          (arity a ln ts 2)
          (enc 1 pin lvl 0)
        })
      (strEq m "release")
      (let ((pin (operand
        a
        ln
        ts
        1
        "pin"
        7)))
        {
          (arity a ln ts 1)
          (enc 1 pin 0 1)
        })
      (|| (strEq m "shift") (strEq m "shift_push"))
      (let ((pin (operand
        a
        ln
        ts
        1
        "pin"
        7)))
        {
          (arity a ln ts 1)
          (enc
            2
            pin
            0
            (if (strEq m "shift_push")
              1
              0))
        })
      (strEq m "capture")
      (let ((pin (operand
        a
        ln
        ts
        1
        "pin"
        7)))
        {
          (arity a ln ts 1)
          (enc 2 pin 1 0)
        })
      (strEq m "pipe_bit")
      (let ((pin (operand
        a
        ln
        ts
        1
        "pin"
        7)))
        {
          (arity a ln ts 1)
          (enc 2 pin 1 256)
        })
      (strEq m "pipe_status")
      {
        (arity a ln ts 0)
        (enc 2 0 1 512)
      }
      (strEq m "pipe_ctrl")
      (enc 2 0 1 (| 768 (pipeCtrlOps a ln ts)))
      (|| (strEq m "br_high") (strEq m "br_low"))
      (let (
        (pin (operand
          a
          ln
          ts
          1
          "pin"
          7))
        (t (target a ln ts 2))
      )
        {
          (arity a ln ts 2)
          (enc
            3
            pin
            (if (strEq m "br_high")
              1
              0)
            t)
        })
      (- 0 1))))

; uE1 (protocol) instruction word, or -1 when the mnemonic is unknown.
;@axiom:effect(io)
(:: encProto (-> Asm Int (Vec String) Int))
(fn (encProto a ln ts)
  (let ((m (tok ts 0)))
    (if (strEq m "pop")
      {
        (arity a ln ts 0)
        (enc 0 0 0 0)
      }
      (strEq m "emit")
      (let (
        (pin (operand
          a
          ln
          ts
          1
          "pin"
          7))
        (lvl (operand
          a
          ln
          ts
          2
          "level"
          1))
      )
        {
          (arity a ln ts 2)
          (enc 1 pin lvl 0)
        })
      (strEq m "release")
      (let ((pin (operand
        a
        ln
        ts
        1
        "pin"
        7)))
        {
          (arity a ln ts 1)
          (enc 1 pin 0 1)
        })
      (|| (strEq m "br_bit1") (strEq m "br_bit0"))
      ; bits 0-7 live in the pin field, bits 8-15 set payload[9]
      (let (
        (bit (operand
          a
          ln
          ts
          1
          "word bit"
          15))
        (t (target a ln ts 2))
      )
        {
          (arity a ln ts 2)
          (enc
            2
            (& bit 7)
            (if (strEq m "br_bit1")
              1
              0)
            (|
              t
              (if (>= bit 8)
                512
                0)))
        })
      (|| (strEq m "br_high") (strEq m "br_low"))
      (let (
        (pin (operand
          a
          ln
          ts
          1
          "pin"
          7))
        (t (target a ln ts 2))
      )
        {
          (arity a ln ts 2)
          (enc
            3
            pin
            (if (strEq m "br_high")
              1
              0)
            t)
        })
      (- 0 1))))

; ------------------------------------------------------------------
; The two passes
; ------------------------------------------------------------------
(:: sectWords (-> Asm (Vec Int)))
(fn (sectWords a)
  (if (== a.sect (sectPhys))
    a.phys
    a.proto))

; Pass 1 counts words per section so labels have addresses. Pass 2
; encodes. Both read the same token stream and switch sections on the
; same directives, so an address pass 1 assigns is the address pass 2
; writes to.
;@axiom:effect(io)
(:: runPass (-> Asm (Vec String) Int Int))
(fn (runPass a lines pass)
  (let (
    (mut li 0)
    (mut pc0 0)
    (mut pc1 0)
  )
    {
      (set a.sect (sectNone))
      (while (< li (vecLen lines))
        (let (
          (line (vecGet lines li))
          (ln (+ li 1))
          (ts0 (tokens line))
          (mut first 0)
        )
          {
            ; leading `name:` labels
            (while (&& (< first (vecLen ts0)) (endsWithColon (tok ts0 first)))
              {
                (if (== pass 1)
                  (defineLabel
                    a
                    ln
                    (labelOf (tok ts0 first))
                    (if (== a.sect (sectPhys))
                      pc0
                      pc1))
                  0)
                (set first (+ first 1))
              })
            (let ((ts vecNew))
              {
                (let ((mut k first))
                  (while (< k (vecLen ts0))
                    {
                      (vecPush ts (tok ts0 k))
                      (set k (+ k 1))
                    }))
                (if (== (vecLen ts) 0)
                  0
                  (let ((m (tok ts 0)))
                    (if (strEq m ".phys")
                      {
                        (arity a ln ts 0)
                        (set a.sect (sectPhys))
                        0
                      }
                      (strEq m ".protocol")
                      {
                        (arity a ln ts 0)
                        (set a.sect (sectProto))
                        0
                      }
                      (strEq m ".prescale")
                      (if (== pass 1)
                        {
                          (if a.prescaleSet
                            (report a ln ".prescale given twice")
                            0)
                          (set a.prescale (operand
                            a
                            ln
                            ts
                            1
                            "prescale"
                            255))
                          (set a.prescaleSet true)
                          (arity a ln ts 1)
                        }
                        0)
                      (strEq m ".cfg")
                      (if (== pass 1)
                        (let ((mut k 1))
                          {
                            (if (< (vecLen ts) 2)
                              (report a ln ".cfg needs at least one byte")
                              0)
                            (while (< k (vecLen ts))
                              {
                                (vecPush a.cfg (operand
                                  a
                                  ln
                                  ts
                                  k
                                  "config byte"
                                  255))
                                (set k (+ k 1))
                              })
                            (if (> (vecLen a.cfg) (cfgMax))
                              (report a ln "more than 9 config bytes in total")
                              0)
                          })
                        0)
                      (== a.sect (sectNone))
                      (report a ln (format "instruction `{m}` before any .phys or .protocol line"))
                      (== pass 1)
                      {
                        (if (== a.sect (sectPhys))
                          (set pc0 (+ pc0 1))
                          (set pc1 (+ pc1 1)))
                        0
                      }
                      (let ((w 
                        (if (strEq m ".word")
                          (let ((v (operand
                            a
                            ln
                            ts
                            1
                            "word"
                            65535)))
                            {
                              (arity a ln ts 1)
                              v
                            })
                          (if (== a.sect (sectPhys))
                            (encPhys a ln ts)
                            (encProto a ln ts)))))
                        (if (< w 0)
                          (report
                            a
                            ln
                            (if (== a.sect (sectPhys))
                              (format "unknown uE0 (.phys) instruction `{m}`")
                              (format "unknown uE1 (.protocol) instruction `{m}`")))
                          {
                            (vecPush (sectWords a) w)
                            (vecPush
                              (if (== a.sect (sectPhys))
                                a.physSrc
                                a.protoSrc)
                              (strTrim (stripComment line)))
                            0
                          })))))
              })
            (set li (+ li 1))
          }))
      (if (> pc0 (ramDepth))
        (report a 0 (format ".phys program is {pc0} words; uE0 holds 512"))
        0)
      (if (> pc1 (ramDepth))
        (report a 0 (format ".protocol program is {pc1} words; uE1 holds 512"))
        0)
      0
    }))

; ------------------------------------------------------------------
; Output
; ------------------------------------------------------------------
(:: hex2 (-> Int String))
(fn (hex2 n)
  (fmtPadZerosLeft (fmtHex n) 2))

(:: hex4 (-> Int String))
(fn (hex4 n)
  (fmtPadZerosLeft (fmtHex n) 4))

(:: wordAt (-> (Vec Int) Int Int))
(fn (wordAt v i)
  (cast Int (vecGet v i)))

; A word's two bytes XORed together - what the loader folds per word.
(:: byteFold (-> Int Int))
(fn (byteFold w)
  (^ (& w 255) (& (>> w 8) 255)))

(:: checksum (-> Asm Int))
(fn (checksum a)
  (let ((mut c 0))
    {
      (for i in 0..(vecLen a.cfg)
        (set c (^ c (wordAt a.cfg i))))
      (for i in 0..(vecLen a.phys)
        (set c (^ c (byteFold (wordAt a.phys i)))))
      (for i in 0..(vecLen a.proto)
        (set c (^ c (byteFold (wordAt a.proto i)))))
      c
    }))

(:: c3 (-> String String String String))
(fn (c3 a b c)
  (concat (concat a b) c))

(:: c5 (-> String String String String String String))
(fn (c5 a b c d e)
  (concat (c3 a b c) (concat d e)))

(:: listSection (-> String (Vec Int) (Vec String) String))
(fn (listSection title words src)
  (let ((mut out (c3 title " (" (c3 (fmtInt (vecLen words)) " words)" "\n"))))
    {
      (for i in 0..(vecLen words)
        (set out (concat out (c5
          "  "
          (fmtPadLeft (fmtInt i) 3)
          "  "
          (hex4 (wordAt words i))
          (c3 "  " (vecGet src i) "\n")))))
      out
    }))

(:: listing (-> Asm String))
(fn (listing a)
  (c5
    (c5
      "prescale "
      (fmtInt a.prescale)
      ", "
      (fmtInt (vecLen a.cfg))
      " config byte(s)\n")
    (listSection "uE0 .phys" a.phys a.physSrc)
    (listSection "uE1 .protocol" a.proto a.protoSrc)
    "load checksum (uo_out before go): 0x"
    (concat (hex2 (checksum a)) "\n")))

(:: jsonList (-> (Vec Int) String))
(fn (jsonList v)
  (let ((mut out "["))
    {
      (for i in 0..(vecLen v)
        (set out (c3
          out
          (if (== i 0)
            ""
            ", ")
          (fmtInt (wordAt v i)))))
      (concat out "]")
    }))

(:: toJson (-> Asm String))
(fn (toJson a)
  (c5
    (c3 "{\n  \"prescale\": " (fmtInt a.prescale) ",\n")
    (c3 "  \"cfg\": " (jsonList a.cfg) ",\n")
    (c3 "  \"phys\": " (jsonList a.phys) ",\n")
    (c3 "  \"protocol\": " (jsonList a.proto) ",\n")
    (c3 "  \"checksum\": " (fmtInt (checksum a)) "\n}\n")))

; One strobe: `<ui_in> <uio_in>` in hex, uio_in WITHOUT the strobe bit.
; uio_in bits: 0 strobe, 1 byte_sel, 2 go, 3 engine_sel, 4 cfg_sel.
(:: strobeLine (-> Int Int String))
(fn (strobeLine data uio)
  (c5
    (hex2 data)
    " "
    (hex2 uio)
    "\n"
    ""))

(:: wordLines (-> (Vec Int) Int String))
(fn (wordLines words engineBit)
  (let ((mut out ""))
    {
      (for i in 0..(vecLen words)
        (let ((w (wordAt words i)))
          (set out (c3 out (strobeLine (& w 255) engineBit) (strobeLine (>> w 8) (| engineBit 2))))))
      out
    }))

(:: loadScript (-> Asm String))
(fn (loadScript a)
  (let ((mut out (c3 "# tdasm load script for tt_um_dual. Hold rst_n low, release it, then\n# for each `<ui_in> <uio_in>` line (hex): drive ui_in and uio_in, raise\n# uio_in bit 0 (strobe), lower it. Waiting a few clocks at each step\n# is enough (strobe passes a 2-FF synchroniser). After the last line\n# read uo_out: it must equal `checksum`. Then pulse uio_in bit 2 (go).\n" "# prescale\n" (strobeLine a.prescale 0))))
    {
      (set out (if (> (vecLen a.cfg) 0)
        (concat out "# bit-pipe config (cfg_sel)\n")
        out))
      (for i in 0..(vecLen a.cfg)
        (set out (concat out (strobeLine (wordAt a.cfg i) 16))))
      (set out (c5
        out
        "# uE0 .phys, "
        (fmtInt (vecLen a.phys))
        " words\n"
        (wordLines a.phys 0)))
      (set out (c5
        out
        "# uE1 .protocol, "
        (fmtInt (vecLen a.proto))
        " words\n"
        (wordLines a.proto 8)))
      (c3 out "checksum " (concat (hex2 (checksum a)) "\ngo\n"))
    }))

;@axiom:effect(io)
(:: writeOut (-> String String Int))
(fn (writeOut path s)
  (match (writeFile path s)
    ((Ok n) 0)
    ((Err e) (die (format "tdasm: cannot write {path}") 1))))

; ------------------------------------------------------------------
; Driver
; ------------------------------------------------------------------
;@axiom:effect(io)
(:: usage Int)
(fn (usage)
  (die "usage: tdasm <prog.tds> [--json out.json] [--load out.load] [--quiet]" 2))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (if (< sysArgc 2)
    (usage)
    (let (
      (src (sysArg 1))
      (mut jsonPath "")
      (mut loadPath "")
      (mut quiet false)
      (mut i 2)
    )
      {
        (while (< i sysArgc)
          (let ((f (sysArg i)))
            (if (&& (strEq f "--json") (< (+ i 1) sysArgc))
              {
                (set jsonPath (sysArg (+ i 1)))
                (set i (+ i 2))
              }
              (&& (strEq f "--load") (< (+ i 1) sysArgc))
              {
                (set loadPath (sysArg (+ i 1)))
                (set i (+ i 2))
              }
              (strEq f "--quiet")
              {
                (set quiet true)
                (set i (+ i 1))
              }
              {
                (usage)
                (set i sysArgc)
              })))
        (if (neg (fileExists src))
          (die (format "tdasm: cannot read {src}") 1)
          0)
        (let (
          (a newAsm)
          (lines (strSplit (readFile src) 10))
        )
          {
            (runPass a lines 1)
            (if (== a.errors 0)
              (runPass a lines 2)
              0)
            (if (== a.errors 0)
              (if (neg a.prescaleSet)
                (report a 0 "missing .prescale line")
                0)
              0)
            (if (> a.errors 0)
              (let ((n a.errors))
                (die (format "tdasm: {n} error(s), nothing written") 1))
              {
                (if quiet
                  0
                  (writeStr stdout (listing a)))
                (if (strIsEmpty jsonPath)
                  0
                  (writeOut jsonPath (toJson a)))
                (if (strIsEmpty loadPath)
                  0
                  (writeOut loadPath (loadScript a)))
                0
              })
          })
      })))
