; USB low-speed receive: decode one packet through the bit pipe (NRZI,
; un-stuffing, CRC16) and report whether its CRC checked out.
; Same program and config as gen_vectors.ml's usb_program /
; usb_protocol_prog / usb_cfg_bytes (timing from test_usb_rx.ml: 32
; cycles a bit, prescale 0).
;   uio pins: 0 D-, 1 D+, 2 FLAG_OK, 3 FLAG_DONE

.prescale 0

; Bit-pipe configuration, bitpipe.ml's 9 bytes:
.cfg 0x1B           ; NRZI on, stuffing on, CRC on, CRC reflected, LSB first
.cfg 0x06           ; stuff after 6 ones, glitch filter off
.cfg 0x2F           ; CRC width 16, CRC skips 2 bytes (SYNC + PID)
.cfg 0x01 0xA0      ; CRC16 polynomial, reflected (0xA001)
.cfg 0xFF 0xFF      ; CRC init 0xFFFF
.cfg 0x01 0xB0      ; good-packet residue 0xB001

.phys
        pipe_ctrl reset idle_high   ; clear the stream, idle line is J
        wait_fall 0 0               ; SOP: first K on D-
        wait_fall 0 12              ; move to the middle of the bit
        br_low 0 sample
next:   wait_fall 0 27              ; one bit period later
sample: br_high 1 k_state           ; D+ high: K
        br_high 0 j_state           ; D- high: J
        br_low 0 eop                ; both low: SE0, end of packet
k_state:
        release 7                   ; no-op, keeps the K path's timing equal
        pipe_bit 0
        br_low 0 next
j_state:
        pipe_bit 0
        br_high 0 next
eop:    pipe_status                 ; push {bytes, stuff_err, crc_ok}
        halt

.protocol
top:    pop
        br_bit1 15 status           ; bit 15 marks the status word
        br_bit0 15 top              ; data byte: skip it
status: br_bit0 0 bad               ; crc_ok
        br_bit1 1 bad               ; stuff_err
        br_bit0 2 bad               ; byte-aligned
        emit 2 1                    ; FLAG_OK
        br_bit1 15 done
bad:    emit 2 0
done:   emit 3 1                    ; FLAG_DONE
        pop
